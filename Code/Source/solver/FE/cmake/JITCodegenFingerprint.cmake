# JITCodegenFingerprint.cmake - Fingerprint of the compiled-kernel code generator
#
# Script mode (cmake -P). Writes FINGERPRINT_OUTPUT, a header defining
# SVMP_FE_JIT_CODEGEN_FINGERPRINT: the SHA-256 of the sorted list of
# FINGERPRINT_SOURCES (paths relative to FINGERPRINT_ROOT), each followed by
# the SHA-256 of its contents. The JIT object cache folds it into its keys, so
# binaries built from different code-generator sources never load each
# other's kernel objects, while binaries built from the same sources (in any
# checkout) still share them.
#
# The header is rewritten only when the fingerprint changes.

if(NOT DEFINED FINGERPRINT_ROOT OR NOT DEFINED FINGERPRINT_SOURCES OR NOT DEFINED FINGERPRINT_OUTPUT)
    message(FATAL_ERROR "JITCodegenFingerprint.cmake: FINGERPRINT_ROOT, FINGERPRINT_SOURCES and FINGERPRINT_OUTPUT are required")
endif()

set(_sources ${FINGERPRINT_SOURCES})
list(SORT _sources)
set(_manifest "")
foreach(_relative IN LISTS _sources)
    file(SHA256 "${FINGERPRINT_ROOT}/${_relative}" _file_hash)
    string(APPEND _manifest "${_relative}\n${_file_hash}\n")
endforeach()
string(SHA256 _fingerprint "${_manifest}")

set(_content "// Generated by FE/cmake/JITCodegenFingerprint.cmake. Do not edit.\n#pragma once\n#define SVMP_FE_JIT_CODEGEN_FINGERPRINT \"${_fingerprint}\"\n")
set(_existing "")
if(EXISTS "${FINGERPRINT_OUTPUT}")
    file(READ "${FINGERPRINT_OUTPUT}" _existing)
endif()
if(NOT _existing STREQUAL _content)
    file(WRITE "${FINGERPRINT_OUTPUT}" "${_content}")
endif()
